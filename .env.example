# Dev: Vite middleware POST /api/rsvp uses these (token not sent in browser GET).
# Production: если задан VITE_RSVP_RELAY_URL, лучше НЕ класть VITE_TG_* в CI — токен не попадёт в JS (и в Network).
VITE_TG_BOT_TOKEN=""
VITE_TG_CHAT_ID=""

# Production (GitHub Pages): guest POSTs here; relay calls Telegram (browser never hits api.telegram.org).
# Варианты без VPS:
#   • Beget / любой хостинг с PHP: залить rsvp-relay/php/rsvp.php → https://ваш-сайт.ru/rsvp.php
#   • Бесплатно: Google Apps Script — rsvp-relay/google-apps-script/Code.gs → URL развёртывания
#   • Node: rsvp-relay/server.mjs на любом хосте с Node
# VITE_RSVP_RELAY_URL="https://example.com/rsvp.php"

# Optional shared secret (same value as RSVP_RELAY_SECRET on the relay). Sent as header X-Rsvp-Secret.
# VITE_RSVP_RELAY_SECRET=""

# Alias for VITE_RSVP_RELAY_URL (older name).
# VITE_RSVP_API_URL="https://your-relay.example.com/rsvp"
