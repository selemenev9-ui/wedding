}

function handleHeroSplitResize() {
    if (!heroSplitTagline) return;

    if (heroIntroTimeline) {
        heroIntroTimeline.kill();
        heroIntroTimeline = null;
        heroIntroCompleted = true;
        if (glassRing?.mesh) {
            gsap.set(glassRing.mesh.scale, { x: 1, y: 1, z: 1 });
