        gsap.set('.hero-scroll-indicator', {
            opacity: 1,
            scaleY: 1,
            transformOrigin: 'top center',
        });
    }

    rebuildHeroSplits(heroIntroCompleted ? 'visible' : 'hidden');
    fitHeroNamesToViewport();
    ScrollTrigger.refresh();
}

window.addEventListener('resize', () => {
