    const ringScaleIn = { x: 1, y: 1, z: 1, duration: 3.2, ease: 'expo.out' };
    if (glassRing?._built) {
        gsap.set(glassRing.mesh.rotation, { y: Math.PI * -0.15, z: Math.PI * 0.05 });
