    heroIntroTimeline.fromTo(
        '#hero-names',
        { opacity: 0, y: 20, xPercent: -50, yPercent: -50, x: 0 },
        {
            opacity: 1,
            y: 0,
            xPercent: -50,
            yPercent: -50,
            x: 0,
            duration: 1.2,
        },
        introSt,
    );
    heroIntroTimeline.fromTo(
        '.hero-bottom',
        { opacity: 0, y: 20 },
